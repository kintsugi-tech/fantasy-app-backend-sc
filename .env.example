# Copy to .env and fill in. NEVER commit real keys.
# Read by hardhat.config.ts through configVariable(...).

# --- Injective EVM testnet (chainId 1439) ---
# Use the sentry endpoint, not k8s.* (it returns null receipts).
INJECTIVE_TESTNET_RPC_URL=https://testnet.sentry.chain.json-rpc.injective.network/
INJECTIVE_TESTNET_DEPLOYER_KEY=0x

# --- Injective EVM mainnet (chainId 1776) ---
# The deployer may need to be in the EVM `authorized_deployers` param: ask Injective first.
INJECTIVE_MAINNET_RPC_URL=https://sentry.evm-rpc.injective.network/
INJECTIVE_MAINNET_DEPLOYER_KEY=0x
